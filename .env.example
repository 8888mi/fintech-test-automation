# Copy to .env and adjust. Defaults match docker-compose.
ENVIRONMENT=local

API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=10
API_RETRY_ATTEMPTS=3

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PAYMENTS_TOPIC=payments.events
KAFKA_EVENT_TIMEOUT_SECONDS=15

# Against a secured broker:
# KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

UI_BASE_URL=http://localhost:8000
# Copy this file to .env and set UI_HEADLESS=false there to watch the browser.
# Keep it true here: this template mirrors the CI-safe defaults, and a CI runner
# has no X server. The --headed / --slowmo flags win over both.
UI_HEADLESS=true
UI_SLOW_MO_MS=0
UI_DEFAULT_TIMEOUT_MS=10000
